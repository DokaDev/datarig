# The settings every recording shares (each tape Sources it): the terminal, the font with
# the explorer's Nerd Font icons, and a fixed size and pace, so every render looks the same.
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 15
Set Width 1440
Set Height 810
Set Padding 12
Set Theme "TokyoNight"
Set TypingSpeed 70ms
Set Framerate 25
Set CursorBlink false
Set WaitTimeout 20s
