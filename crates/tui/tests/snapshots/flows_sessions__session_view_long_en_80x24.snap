"╭ ╭ Session settings — local-pg ─────────────────────────────────────────────╮─╮"
"│ │ local-pg · PostgreSQL · environment prod                                 │ │"
"│▾│                                                                          │ │"
"│ │ Lock wait        the server's setting  app setting                       │ │"
"│▾│ Idle disconnect  never                 app setting                       │ │"
"│ │ Idle rollback    30m                   environment prod                  │ │"
"│ │                                                                          │ │"
"│▾│ From the Startup SQL “reporting” of the environment prod:                │ │"
"│ │   SET statement_timeout = '30s'                                          │ │"
"│ │     behind a pooler: per transaction as SET LOCAL statement_timeout =    │ │"
"│ │        '30s'                                                             │ │"
"│ │   SET work_mem = '64MB'                                                  │ │"
"│ │     behind a pooler: per transaction as SET LOCAL work_mem = '64MB'      │ │"
"│ │ From its own startup SQL:                                                │ │"
"│ │   SET work_mem = '1MB'                                                   │ │"
"│ │     behind a pooler: per transaction as SET LOCAL work_mem = '1MB'       │ │"
"│ │   SET work_mem = '2MB'                                                   │ │"
"│ │     behind a pooler: per transaction as SET LOCAL work_mem = '2MB'       │ │"
"│ │                                                          ↓ 24 more lines │ │"
"│ │ Applied in this order: a later setting of the same name wins             │ │"
"│ │                                                                          │ │"
"│ │                                [ Close ]                                 │ │"
