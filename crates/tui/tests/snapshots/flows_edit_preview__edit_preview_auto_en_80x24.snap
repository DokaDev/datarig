"╭ Explorer ────────────╮ 1 console 1 ×                                          "
"│ ╭ Apply changes — shop.users ──────────────────────────────────────────────╮─╮"
"│▾│ 1 update · 1 insert · 1 delete                                           │ │"
"│ │                                                                          │e│"
"│ │ Row checks (lock, no waiting)                                            │ │"
"│ │   SELECT 1 FROM "shop"."users" WHERE "id" = '1' AND "email" =   expect 1 │ │"
"│ │     'a@x' FOR UPDATE NOWAIT                                              │ │"
"│ │   SELECT 1 FROM "shop"."users" WHERE "id" = '2' AND "email" =   expect 1 │ │"
"│ │     'b@x' AND "nickname" IS NULL FOR UPDATE NOWAIT                       │ │"
"│ │ Writes                                                                   │─╯"
"│ │ ! DELETE FROM "shop"."users" WHERE "id" = '2' AND "email" =     expect 1 │─╮"
"│ │     'b@x' AND "nickname" IS NULL                                         │…│"
"│ │   UPDATE "shop"."users" SET "email" = 'z@x' WHERE "id" = '1'    expect 1 │ │"
"│ │     AND "email" = 'a@x' RETURNING *                                      │ │"
"│ │   INSERT INTO "shop"."users" ("email") VALUES ('n@x')           expect 1 │ │"
"│ │     RETURNING *                                                          │ │"
"│ │                                                                          │ │"
"│ │ Runs in one transaction; commits at the end.                             │ │"
"│ │                                                                          │ │"
"│ │                  [ Cancel ]     Copy SQL       Apply                     │ │"
"│ ╰─────────────────── y apply · c copy SQL · j/k scroll · Enter/Esc cancel ─╯ │"
"│                      ││                              ││                      │"
"╰──────────────────────╯╰──────────────────────────────╯╰──────────────────────╯"
