---
source: crates/drivers/postgres/src/meta/monitor/tests.rs
expression: "text.join(\"\\n\")"
---
-- probe
SELECT current_setting('server_version_num') AS version, (SELECT rolsuper FROM pg_roles WHERE rolname = current_user) AS superuser, pg_has_role(current_user, 'pg_read_all_stats', 'USAGE') AS read_all_stats, pg_has_role(current_user, 'pg_signal_backend', 'USAGE') AS signal_backend, array_to_string(ARRAY(SELECT n FROM (SELECT rolname::text FROM pg_roles WHERE rolname IN ('alloydbsuperuser', 'rds_superuser', 'cloudsqlsuperuser', 'azure_pg_admin') UNION ALL SELECT 'aurora_version' WHERE to_regproc('aurora_version') IS NOT NULL) m(n) ORDER BY 1), ',') AS markers

-- server info
SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, version() AS version, (extract(epoch FROM pg_postmaster_start_time()) * 1000000)::int8 AS started, pg_is_in_recovery() AS in_recovery, current_setting('max_connections')::int8 AS max_connections, pg_size_bytes(current_setting('shared_buffers')) AS shared_buffers, current_setting('track_io_timing') AS track_io_timing, current_setting('track_activities') AS track_activities, current_setting('track_counts') AS track_counts, current_setting('track_activity_query_size') AS track_activity_query_size, current_setting('wal_level') AS wal_level

-- counters
SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, d.*, current_setting('track_counts')::bool AS track_counts, s.* FROM (SELECT sum(xact_commit)::int8 AS commits, sum(xact_rollback)::int8 AS rollbacks, sum(blks_read)::int8 AS blks_read, sum(blks_hit)::int8 AS blks_hit, sum(tup_returned)::int8 AS tup_returned, sum(tup_inserted + tup_updated + tup_deleted)::int8 AS tup_written, sum(tup_inserted)::int8 AS tup_inserted, sum(tup_updated)::int8 AS tup_updated, sum(tup_deleted)::int8 AS tup_deleted, sum(deadlocks)::int8 AS deadlocks, sum(temp_bytes)::int8 AS temp_bytes, count(*) AS databases, max((extract(epoch FROM stats_reset) * 1000000)::int8) AS stats_reset FROM pg_stat_database) d, (SELECT count(*) FILTER (WHERE backend_type = 'client backend') AS sessions, count(*) FILTER (WHERE backend_type = 'client backend' AND state = 'active' AND pid <> pg_backend_pid()) AS active, count(*) FILTER (WHERE state IN ('idle in transaction', 'idle in transaction (aborted)')) AS idle_in_tx, count(*) FILTER (WHERE state = 'idle') AS idle, count(*) FILTER (WHERE wait_event_type = 'Lock') AS waiting, count(*) FILTER (WHERE state IS NULL AND query = '<insufficient privilege>') AS hidden, count(*) FILTER (WHERE class = 'running') AS class_running, count(*) FILTER (WHERE class = 'waiting') AS class_waiting, count(*) FILTER (WHERE class = 'idle in tx') AS class_idle_in_tx, count(*) FILTER (WHERE class = 'idle') AS class_idle, count(*) FILTER (WHERE class = 'background') AS class_background, count(*) FILTER (WHERE class = 'unknown') AS class_unknown FROM (SELECT pid, backend_type, state, wait_event_type, query, CASE WHEN pid = pg_backend_pid() THEN NULL WHEN backend_type <> 'client backend' THEN 'background' WHEN state IS NULL OR state = 'disabled' THEN 'unknown' WHEN wait_event_type = 'Lock' THEN 'waiting' WHEN state IN ('active', 'fastpath function call') THEN 'running' WHEN state IN ('idle in transaction', 'idle in transaction (aborted)') THEN 'idle in tx' WHEN state = 'idle' THEN 'idle' ELSE 'unknown' END AS class FROM pg_stat_activity) a) s

-- sessions
WITH a AS (SELECT s.pid, s.leader_pid AS leader_pid, s.usename::text AS usename, s.datname::text AS datname, s.application_name, host(s.client_addr) AS client_addr, s.client_port, s.backend_type, s.state, s.wait_event_type, s.wait_event, (extract(epoch FROM s.backend_start) * 1000000)::int8 AS backend_start, (extract(epoch FROM s.xact_start) * 1000000)::int8 AS xact_start, (extract(epoch FROM s.query_start) * 1000000)::int8 AS query_start, (extract(epoch FROM s.state_change) * 1000000)::int8 AS state_change, left(s.query, 256) AS query, char_length(s.query) > 256 AS shortened, octet_length(s.query) >= t.size - 4 AS maybe_cut, s.pid = pg_backend_pid() AS monitor FROM pg_stat_activity s, (SELECT setting::int AS size FROM pg_settings WHERE name = 'track_activity_query_size') t), w AS (SELECT pid FROM a WHERE wait_event_type = 'Lock' ORDER BY state_change NULLS LAST, pid LIMIT 50), b AS (SELECT pid, pg_blocking_pids(pid) AS blockers FROM w) SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, a.*, b.blockers::text AS blocked_by FROM a LEFT JOIN b ON b.pid = a.pid ORDER BY a.pid

-- sessions without idle
WITH a AS (SELECT s.pid, s.leader_pid AS leader_pid, s.usename::text AS usename, s.datname::text AS datname, s.application_name, host(s.client_addr) AS client_addr, s.client_port, s.backend_type, s.state, s.wait_event_type, s.wait_event, (extract(epoch FROM s.backend_start) * 1000000)::int8 AS backend_start, (extract(epoch FROM s.xact_start) * 1000000)::int8 AS xact_start, (extract(epoch FROM s.query_start) * 1000000)::int8 AS query_start, (extract(epoch FROM s.state_change) * 1000000)::int8 AS state_change, left(s.query, 256) AS query, char_length(s.query) > 256 AS shortened, octet_length(s.query) >= t.size - 4 AS maybe_cut, s.pid = pg_backend_pid() AS monitor FROM pg_stat_activity s, (SELECT setting::int AS size FROM pg_settings WHERE name = 'track_activity_query_size') t), w AS (SELECT pid FROM a WHERE wait_event_type = 'Lock' ORDER BY state_change NULLS LAST, pid LIMIT 50), b AS (SELECT pid, pg_blocking_pids(pid) AS blockers FROM w) SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, a.*, b.blockers::text AS blocked_by FROM a LEFT JOIN b ON b.pid = a.pid WHERE a.state IS DISTINCT FROM 'idle' OR a.monitor OR a.pid IN (SELECT unnest(b.blockers) FROM b) ORDER BY a.pid

-- query text
SELECT s.pid, (extract(epoch FROM s.backend_start) * 1000000)::int8 AS backend_start, s.state, (extract(epoch FROM s.query_start) * 1000000)::int8 AS query_start, s.query, octet_length(s.query) >= t.size - 4 AS maybe_cut FROM pg_stat_activity s, (SELECT setting::int AS size FROM pg_settings WHERE name = 'track_activity_query_size') t WHERE s.pid = 4211

-- session
WITH a AS (SELECT s.pid, s.leader_pid AS leader_pid, s.usename::text AS usename, s.datname::text AS datname, s.application_name, host(s.client_addr) AS client_addr, s.client_port, s.backend_type, s.state, s.wait_event_type, s.wait_event, (extract(epoch FROM s.backend_start) * 1000000)::int8 AS backend_start, (extract(epoch FROM s.xact_start) * 1000000)::int8 AS xact_start, (extract(epoch FROM s.query_start) * 1000000)::int8 AS query_start, (extract(epoch FROM s.state_change) * 1000000)::int8 AS state_change, left(s.query, 256) AS query, char_length(s.query) > 256 AS shortened, octet_length(s.query) >= t.size - 4 AS maybe_cut, s.pid = pg_backend_pid() AS monitor FROM pg_stat_activity s, (SELECT setting::int AS size FROM pg_settings WHERE name = 'track_activity_query_size') t), w AS (SELECT pid FROM a WHERE wait_event_type = 'Lock' ORDER BY state_change NULLS LAST, pid LIMIT 50) SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, a.*, CASE WHEN a.pid IN (SELECT pid FROM w) THEN pg_blocking_pids(a.pid)::text END AS blocked_by FROM a WHERE a.pid = 1 OR a.monitor ORDER BY a.pid

-- locks
WITH l AS MATERIALIZED (SELECT l.locktype, l.database, l.relation, l.page, l.tuple, l.virtualxid, l.transactionid, l.classid, l.objid, l.objsubid, l.virtualtransaction, l.pid, l.mode, l.granted, l.waitstart AS waitstart, (l.locktype, l.database, l.relation, l.page, l.tuple, l.virtualxid, l.transactionid, l.classid, l.objid, l.objsubid)::text AS key FROM pg_locks l WHERE EXISTS (SELECT 1 FROM pg_stat_activity WHERE wait_event_type = 'Lock')), w AS (SELECT * FROM l WHERE NOT l.granted AND l.pid IS NOT NULL ORDER BY l.waitstart NULLS LAST, l.pid LIMIT 200), r AS (SELECT 'wait' AS role, w.* FROM w UNION ALL SELECT 'hold', l.* FROM l WHERE l.granted AND l.key IN (SELECT key FROM w)), p AS (SELECT x.gid, x.owner::text AS owner, x.database::text AS database, x.prepared, t.virtualtransaction FROM pg_prepared_xacts x JOIN l t ON t.locktype = 'transactionid' AND t.transactionid = x.transaction AND t.pid IS NULL), d AS (SELECT oid FROM pg_database WHERE datname = current_database()) SELECT r.role, r.key, r.pid, (extract(epoch FROM a.backend_start) * 1000000)::int8 AS backend_start, p.gid, p.owner, (extract(epoch FROM p.prepared) * 1000000)::int8 AS prepared, p.database AS prepared_database, r.locktype, r.mode, CASE WHEN r.database NOT IN (0, (SELECT oid FROM d)) THEN (SELECT datname::text FROM pg_database WHERE oid = r.database) END AS database, CASE WHEN r.relation IS NOT NULL AND r.database IN (0, (SELECT oid FROM d)) THEN r.relation::regclass::text END AS relation, CASE r.locktype WHEN 'transactionid' THEN r.transactionid::text WHEN 'virtualxid' THEN r.virtualxid WHEN 'tuple' THEN '(' || r.page || ',' || r.tuple || ')' WHEN 'page' THEN r.page::text WHEN 'advisory' THEN r.classid || ',' || r.objid || ',' || r.objsubid WHEN 'object' THEN r.classid || ',' || r.objid || ',' || r.objsubid END AS detail, (extract(epoch FROM r.waitstart) * 1000000)::int8 AS since, (extract(epoch FROM a.query_start) * 1000000)::int8 AS query_start, (SELECT count(*) FROM l WHERE NOT l.granted) AS waits FROM r LEFT JOIN pg_stat_activity a ON a.pid = r.pid LEFT JOIN p ON r.pid IS NULL AND p.virtualtransaction = r.virtualtransaction ORDER BY r.role DESC, r.key, r.pid NULLS FIRST LIMIT 2000
