---
source: crates/drivers/postgres/src/meta/monitor/tests.rs
expression: "text.join(\"\\n\")"
---
-- probe
SELECT current_setting('server_version_num') AS version, (SELECT rolsuper FROM pg_roles WHERE rolname = current_user) AS superuser, pg_has_role(current_user, 'pg_read_all_stats', 'USAGE') AS read_all_stats, pg_has_role(current_user, 'pg_signal_backend', 'USAGE') AS signal_backend, array_to_string(ARRAY(SELECT n FROM (SELECT rolname::text FROM pg_roles WHERE rolname IN ('alloydbsuperuser', 'rds_superuser', 'cloudsqlsuperuser', 'azure_pg_admin') UNION ALL SELECT 'aurora_version' WHERE to_regproc('aurora_version') IS NOT NULL) m(n) ORDER BY 1), ',') AS markers

-- server info
SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, version() AS version, (extract(epoch FROM pg_postmaster_start_time()) * 1000000)::int8 AS started, pg_is_in_recovery() AS in_recovery, current_setting('max_connections')::int8 AS max_connections, pg_size_bytes(current_setting('shared_buffers')) AS shared_buffers, current_setting('track_io_timing') AS track_io_timing

-- counters
SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, d.*, s.* FROM (SELECT sum(xact_commit)::int8 AS commits, sum(xact_rollback)::int8 AS rollbacks, sum(blks_read)::int8 AS blks_read, sum(blks_hit)::int8 AS blks_hit, sum(tup_returned)::int8 AS tup_returned, sum(tup_inserted + tup_updated + tup_deleted)::int8 AS tup_written, sum(deadlocks)::int8 AS deadlocks, sum(temp_bytes)::int8 AS temp_bytes, count(*) AS databases, max((extract(epoch FROM stats_reset) * 1000000)::int8) AS stats_reset FROM pg_stat_database) d, (SELECT count(*) FILTER (WHERE backend_type = 'client backend') AS sessions, count(*) FILTER (WHERE backend_type = 'client backend' AND state = 'active' AND pid <> pg_backend_pid()) AS active, count(*) FILTER (WHERE state IN ('idle in transaction', 'idle in transaction (aborted)')) AS idle_in_tx, count(*) FILTER (WHERE state = 'idle') AS idle, count(*) FILTER (WHERE wait_event_type = 'Lock') AS waiting, count(*) FILTER (WHERE state IS NULL AND query = '<insufficient privilege>') AS hidden FROM pg_stat_activity) s

-- sessions
WITH a AS (SELECT s.pid, s.leader_pid AS leader_pid, s.usename::text AS usename, s.datname::text AS datname, s.application_name, host(s.client_addr) AS client_addr, s.client_port, s.backend_type, s.state, s.wait_event_type, s.wait_event, (extract(epoch FROM s.backend_start) * 1000000)::int8 AS backend_start, (extract(epoch FROM s.xact_start) * 1000000)::int8 AS xact_start, (extract(epoch FROM s.query_start) * 1000000)::int8 AS query_start, (extract(epoch FROM s.state_change) * 1000000)::int8 AS state_change, left(s.query, 256) AS query, char_length(s.query) > 256 AS shortened, octet_length(s.query) >= t.size - 4 AS maybe_cut, s.pid = pg_backend_pid() AS monitor FROM pg_stat_activity s, (SELECT setting::int AS size FROM pg_settings WHERE name = 'track_activity_query_size') t), w AS (SELECT pid FROM a WHERE wait_event_type = 'Lock' ORDER BY state_change NULLS LAST, pid LIMIT 50) SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, a.*, CASE WHEN a.pid IN (SELECT pid FROM w) THEN pg_blocking_pids(a.pid)::text END AS blocked_by FROM a ORDER BY a.pid

-- sessions without idle
WITH a AS (SELECT s.pid, s.leader_pid AS leader_pid, s.usename::text AS usename, s.datname::text AS datname, s.application_name, host(s.client_addr) AS client_addr, s.client_port, s.backend_type, s.state, s.wait_event_type, s.wait_event, (extract(epoch FROM s.backend_start) * 1000000)::int8 AS backend_start, (extract(epoch FROM s.xact_start) * 1000000)::int8 AS xact_start, (extract(epoch FROM s.query_start) * 1000000)::int8 AS query_start, (extract(epoch FROM s.state_change) * 1000000)::int8 AS state_change, left(s.query, 256) AS query, char_length(s.query) > 256 AS shortened, octet_length(s.query) >= t.size - 4 AS maybe_cut, s.pid = pg_backend_pid() AS monitor FROM pg_stat_activity s, (SELECT setting::int AS size FROM pg_settings WHERE name = 'track_activity_query_size') t), w AS (SELECT pid FROM a WHERE wait_event_type = 'Lock' ORDER BY state_change NULLS LAST, pid LIMIT 50) SELECT (extract(epoch FROM now()) * 1000000)::int8 AS now, a.*, CASE WHEN a.pid IN (SELECT pid FROM w) THEN pg_blocking_pids(a.pid)::text END AS blocked_by FROM a WHERE a.state IS DISTINCT FROM 'idle' OR a.monitor ORDER BY a.pid

-- query text
SELECT s.pid, (extract(epoch FROM s.backend_start) * 1000000)::int8 AS backend_start, s.state, (extract(epoch FROM s.query_start) * 1000000)::int8 AS query_start, s.query, octet_length(s.query) >= t.size - 4 AS maybe_cut FROM pg_stat_activity s, (SELECT setting::int AS size FROM pg_settings WHERE name = 'track_activity_query_size') t WHERE s.pid = 4211
