---
source: crates/drivers/mysql/src/meta/monitor/tests.rs
expression: "text.join(\"\\n\")"
---
-- probe
SELECT VERSION() AS version, @@performance_schema AS performance_schema, CURRENT_USER() AS user

-- probe
SHOW GLOBAL VARIABLES WHERE Variable_name IN ('aurora_version', 'basedir')

-- probe
SELECT PRIVILEGE_TYPE FROM information_schema.USER_PRIVILEGES WHERE GRANTEE = CONCAT(QUOTE(SUBSTRING_INDEX(CURRENT_USER(), '@', 1)), '@', QUOTE(SUBSTRING_INDEX(CURRENT_USER(), '@', -1))) AND PRIVILEGE_TYPE = 'PROCESS'

-- probe
SELECT trx_id FROM information_schema.INNODB_TRX LIMIT 1

-- probe
SELECT i.ENABLED, (SELECT COUNT(*) FROM performance_schema.metadata_locks m JOIN performance_schema.threads t ON t.THREAD_ID = m.OWNER_THREAD_ID WHERE 1 = 0) AS probe FROM performance_schema.setup_instruments i WHERE i.NAME = 'wait/lock/metadata/sql/mdl'

-- probe
SELECT MIN(c.ENABLED) AS ENABLED, (SELECT COUNT(*) FROM performance_schema.events_statements_current e JOIN performance_schema.threads t ON t.THREAD_ID = e.THREAD_ID WHERE 1 = 0) AS probe FROM performance_schema.setup_consumers c WHERE c.NAME IN ('global_instrumentation', 'thread_instrumentation', 'events_statements_current')

-- server info
SELECT CAST(UNIX_TIMESTAMP(NOW(6)) * 1000000 AS SIGNED) AS now, VERSION() AS version, @@version_comment AS version_comment, @@read_only AS read_only, @@super_read_only AS super_read_only, @@server_id AS server_id, @@gtid_mode AS gtid_mode, @@log_bin AS log_bin, @@max_connections AS max_connections, @@innodb_buffer_pool_size AS innodb_buffer_pool_size, @@performance_schema AS performance_schema

-- server info uptime
SHOW GLOBAL STATUS WHERE Variable_name = 'Uptime'

-- clock
SELECT CAST(UNIX_TIMESTAMP(NOW(6)) * 1000000 AS SIGNED) AS now, COUNT(CASE WHEN COALESCE(p.COMMAND, '') IN ('Query', 'Execute') AND p.ID <> CONNECTION_ID() THEN 1 END) AS cmd_query, COUNT(CASE WHEN COALESCE(p.COMMAND, '') = 'Sleep' THEN 1 END) AS cmd_sleep, COUNT(CASE WHEN COALESCE(p.COMMAND, '') = 'Daemon' THEN 1 END) AS cmd_daemon, COUNT(CASE WHEN COALESCE(p.COMMAND, '') IN ('Connect', 'Connect Out') THEN 1 END) AS cmd_connect, COUNT(CASE WHEN COALESCE(p.COMMAND, '') IN ('Binlog Dump', 'Binlog Dump GTID') THEN 1 END) AS cmd_binlog_dump, COUNT(CASE WHEN COALESCE(p.COMMAND, '') NOT IN ('Query', 'Execute', 'Sleep', 'Daemon', 'Connect', 'Connect Out', 'Binlog Dump', 'Binlog Dump GTID') THEN 1 END) AS cmd_other, COUNT(CASE WHEN (p.USER IS NULL OR CAST(p.USER AS BINARY) <> CAST(LEFT(CURRENT_USER(), CHAR_LENGTH(CURRENT_USER()) - CHAR_LENGTH(SUBSTRING_INDEX(CURRENT_USER(), '@', -1)) - 1) AS BINARY)) THEN 1 END) AS others FROM information_schema.PROCESSLIST p

-- status
SHOW GLOBAL STATUS WHERE Variable_name IN ('Uptime', 'Questions', 'Com_commit', 'Com_rollback', 'Threads_connected', 'Threads_running', 'Innodb_buffer_pool_read_requests', 'Innodb_buffer_pool_reads', 'Innodb_rows_read', 'Innodb_rows_inserted', 'Innodb_rows_updated', 'Innodb_rows_deleted', 'Bytes_received', 'Bytes_sent', 'Innodb_row_lock_waits', 'Slow_queries', 'Created_tmp_disk_tables', 'Aborted_connects', 'Performance_schema_thread_instances_lost', 'Performance_schema_metadata_lock_lost', 'Com_select', 'Com_insert', 'Com_insert_select', 'Com_replace', 'Com_replace_select', 'Com_update', 'Com_update_multi', 'Com_delete', 'Com_delete_multi')

-- sessions
SELECT CAST(UNIX_TIMESTAMP(NOW(6)) * 1000000 AS SIGNED) AS now, p.ID, p.USER, p.HOST, p.DB, p.COMMAND, p.TIME, p.STATE, LEFT(p.INFO, 256) AS INFO, CHAR_LENGTH(p.INFO) > 256 AS shortened, p.ID = CONNECTION_ID() AS monitor, CAST(UNIX_TIMESTAMP(t.trx_started) * 1000000 AS SIGNED) AS trx_started, t.trx_state, t.trx_rows_locked, t.trx_rows_modified, 1 AS trx_read, COALESCE(l.in_tx, 0) AS in_tx, COALESCE(l.explicit_locks, 0) AS explicit_locks, 1 AS locks_read, NULL AS THREAD_ID, NULL AS EVENT_ID, MD5(p.INFO) AS info_md5 FROM information_schema.PROCESSLIST p LEFT JOIN information_schema.INNODB_TRX t ON t.trx_mysql_thread_id = p.ID LEFT JOIN (SELECT th.PROCESSLIST_ID AS id, MAX(m.LOCK_DURATION = 'TRANSACTION') AS in_tx, MAX(m.LOCK_DURATION = 'EXPLICIT') AS explicit_locks FROM performance_schema.metadata_locks m JOIN performance_schema.threads th ON th.THREAD_ID = m.OWNER_THREAD_ID WHERE m.LOCK_STATUS = 'GRANTED' AND m.LOCK_DURATION <> 'STATEMENT' GROUP BY th.PROCESSLIST_ID) l ON l.id = p.ID ORDER BY p.ID

-- sessions without idle
SELECT CAST(UNIX_TIMESTAMP(NOW(6)) * 1000000 AS SIGNED) AS now, p.ID, p.USER, p.HOST, p.DB, p.COMMAND, p.TIME, p.STATE, LEFT(p.INFO, 256) AS INFO, CHAR_LENGTH(p.INFO) > 256 AS shortened, p.ID = CONNECTION_ID() AS monitor, CAST(UNIX_TIMESTAMP(t.trx_started) * 1000000 AS SIGNED) AS trx_started, t.trx_state, t.trx_rows_locked, t.trx_rows_modified, 1 AS trx_read, COALESCE(l.in_tx, 0) AS in_tx, COALESCE(l.explicit_locks, 0) AS explicit_locks, 1 AS locks_read, NULL AS THREAD_ID, NULL AS EVENT_ID, MD5(p.INFO) AS info_md5 FROM information_schema.PROCESSLIST p LEFT JOIN information_schema.INNODB_TRX t ON t.trx_mysql_thread_id = p.ID LEFT JOIN (SELECT th.PROCESSLIST_ID AS id, MAX(m.LOCK_DURATION = 'TRANSACTION') AS in_tx, MAX(m.LOCK_DURATION = 'EXPLICIT') AS explicit_locks FROM performance_schema.metadata_locks m JOIN performance_schema.threads th ON th.THREAD_ID = m.OWNER_THREAD_ID WHERE m.LOCK_STATUS = 'GRANTED' AND m.LOCK_DURATION <> 'STATEMENT' GROUP BY th.PROCESSLIST_ID) l ON l.id = p.ID WHERE p.COMMAND <> 'Sleep' OR t.trx_id IS NOT NULL OR l.id IS NOT NULL OR p.ID = CONNECTION_ID() ORDER BY p.ID

-- query text
SELECT CAST(UNIX_TIMESTAMP(NOW(6)) * 1000000 AS SIGNED) AS now, p.ID, p.COMMAND, p.TIME, p.INFO, OCTET_LENGTH(p.INFO) >= 65532 AS maybe_cut FROM information_schema.PROCESSLIST p WHERE p.ID = 4211

-- session before an action
SELECT CAST(UNIX_TIMESTAMP(NOW(6)) * 1000000 AS SIGNED) AS now, p.ID, p.USER, p.HOST, p.DB, p.COMMAND, p.TIME, p.STATE, LEFT(p.INFO, 256) AS INFO, CHAR_LENGTH(p.INFO) > 256 AS shortened, p.ID = CONNECTION_ID() AS monitor, NULL AS trx_started, NULL AS trx_state, NULL AS trx_rows_locked, NULL AS trx_rows_modified, 0 AS trx_read, NULL AS in_tx, NULL AS explicit_locks, 0 AS locks_read, NULL AS THREAD_ID, NULL AS EVENT_ID, MD5(p.INFO) AS info_md5 FROM information_schema.PROCESSLIST p WHERE p.ID IN (63114, CONNECTION_ID()) ORDER BY p.ID

-- session after an action
SELECT CAST(UNIX_TIMESTAMP(NOW(6)) * 1000000 AS SIGNED) AS now, p.ID, p.USER, p.HOST, p.DB, p.COMMAND, p.TIME, p.STATE, LEFT(p.INFO, 256) AS INFO, CHAR_LENGTH(p.INFO) > 256 AS shortened, p.ID = CONNECTION_ID() AS monitor, CAST(UNIX_TIMESTAMP(t.trx_started) * 1000000 AS SIGNED) AS trx_started, t.trx_state, t.trx_rows_locked, t.trx_rows_modified, 1 AS trx_read, COALESCE(l.in_tx, 0) AS in_tx, COALESCE(l.explicit_locks, 0) AS explicit_locks, 1 AS locks_read, NULL AS THREAD_ID, NULL AS EVENT_ID, MD5(p.INFO) AS info_md5 FROM information_schema.PROCESSLIST p LEFT JOIN information_schema.INNODB_TRX t ON t.trx_mysql_thread_id = p.ID LEFT JOIN (SELECT th.PROCESSLIST_ID AS id, MAX(m.LOCK_DURATION = 'TRANSACTION') AS in_tx, MAX(m.LOCK_DURATION = 'EXPLICIT') AS explicit_locks FROM performance_schema.metadata_locks m JOIN performance_schema.threads th ON th.THREAD_ID = m.OWNER_THREAD_ID WHERE m.LOCK_STATUS = 'GRANTED' AND m.LOCK_DURATION <> 'STATEMENT' GROUP BY th.PROCESSLIST_ID) l ON l.id = p.ID WHERE p.ID IN (63114, CONNECTION_ID()) ORDER BY p.ID

-- row lock waits
SELECT rt.PROCESSLIST_ID AS waiter, NULLIF(bx.trx_mysql_thread_id, 0) AS blocker, w.BLOCKING_ENGINE_TRANSACTION_ID AS blocking_trx, bx.trx_id IS NOT NULL AND bx.trx_mysql_thread_id = 0 AS blocking_session_read FROM performance_schema.data_lock_waits w LEFT JOIN performance_schema.threads rt ON rt.THREAD_ID = w.REQUESTING_THREAD_ID LEFT JOIN information_schema.INNODB_TRX bx ON bx.trx_id = w.BLOCKING_ENGINE_TRANSACTION_ID ORDER BY waiter, blocker LIMIT 2000

-- metadata lock waits
WITH m AS (SELECT t.PROCESSLIST_ID AS id, m.OWNER_THREAD_ID AS thread, m.OBJECT_TYPE, m.OBJECT_SCHEMA, m.OBJECT_NAME, m.LOCK_TYPE, m.LOCK_DURATION, m.LOCK_STATUS FROM performance_schema.metadata_locks m LEFT JOIN performance_schema.threads t ON t.THREAD_ID = m.OWNER_THREAD_ID WHERE m.LOCK_STATUS IN ('PENDING', 'GRANTED')) SELECT * FROM m WHERE m.LOCK_STATUS = 'PENDING' UNION ALL SELECT g.* FROM m g WHERE g.LOCK_STATUS = 'GRANTED' AND EXISTS (SELECT 1 FROM m p WHERE p.LOCK_STATUS = 'PENDING' AND p.OBJECT_TYPE = g.OBJECT_TYPE AND p.OBJECT_SCHEMA <=> g.OBJECT_SCHEMA AND p.OBJECT_NAME <=> g.OBJECT_NAME AND p.thread <> g.thread) ORDER BY LOCK_STATUS DESC, OBJECT_TYPE, OBJECT_SCHEMA, OBJECT_NAME, thread LIMIT 2000
